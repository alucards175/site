# Application
APP_NAME="Hitmanki Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hitmanki.store

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hitmanki_store
DB_USERNAME=hitmanki
DB_PASSWORD=hitmanki123

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@hitmanki.store"
MAIL_FROM_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Steam API
STEAM_API_KEY=your_steam_api_key_here
STEAM_RETURN_URL=http://hitmanki.store/auth/steam/callback

# Payment Gateways
# Qiwi
QIWI_PUBLIC_KEY=
QIWI_SECRET_KEY=

# YooMoney
YOOMONEY_CLIENT_ID=
YOOMONEY_CLIENT_SECRET=

# Crypto Bot
CRYPTO_BOT_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# WebSocket Server
WS_HOST=127.0.0.1
WS_PORT=3001

# Frontend
FRONTEND_URL=http://localhost:3000

# Admin Settings
ADMIN_EMAIL=admin@hitmanki.store
ADMIN_PASSWORD=admin123

# Anti-Fraud
MAX_DAILY_DEPOSIT=10000
MAX_HOURLY_CASES=100
MIN_CASE_INTERVAL=1000

# Provably Fair
HOUSE_EDGE=0.05
MIN_SERVER_SEED_LENGTH=64

# File Storage
FILESYSTEM_DISK=local

# Logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cache
CACHE_DRIVER=redis

# Queue
QUEUE_CONNECTION=redis

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Broadcasting
BROADCAST_DRIVER=pusher